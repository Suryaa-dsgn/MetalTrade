# =============================================================================
# Integration configuration — NAMES / PLACEHOLDERS ONLY. No real credentials.
#
# Every integration defaults to a mock / no-op / disabled provider, so the app
# runs fully with NO env set. A live provider is connected only after it is
# explicitly approved; set the matching secret(s) in a real (untracked) .env,
# never here. Secrets are read server-side only (see lib/config/env.ts).
# =============================================================================

# ---- Integration selectors (validated against supported enums) --------------
# Unknown values fall back to the default with a server-side warning.

# Market mode. Supported: registry | mock  (default: registry)
# "registry" = normal per-benchmark routing; each commodity's live provider is
# chosen by the BenchmarkRegistry (Gold via MetalpriceAPI needs METALPRICE_API_KEY
# in an untracked .env.local). "mock" = an explicit full sample/demo build.
# On the Free tier only Gold is live; base metals + history are paid-gated.
# See docs/market-provider-readiness.md.
MARKET_PROVIDER=registry

# Enquiry delivery sink. Supported: log | disabled  (default: log)
# "log" records REDACTED operational metadata only (no PII). No email/CRM.
ENQUIRY_SINK=log

# File-upload provider. Supported: disabled  (default: disabled)
# No storage is connected and no upload endpoint exists in this build.
UPLOAD_PROVIDER=disabled

# Content source (catalogue / editorial / FAQs). Supported: static  (default: static)
CONTENT_SOURCE=static

# ---- Lead persistence (Backend Phase 2C) -----------------------------------
# Where submitted leads are stored. Supported: memory | postgres  (default: memory)
# "memory" is EPHEMERAL (dev/test only) — production fails closed unless a durable
# store is selected AND configured. There is no silent fallback to memory.
LEAD_STORE=memory

# PostgreSQL connection string — required when LEAD_STORE=postgres. Server-only;
# never committed, never logged, never exposed to the client. Works with any managed
# Postgres (AWS RDS/Aurora, Neon, Supabase, …). Set the real value in .env.local.
# DATABASE_URL=postgres://user:password@host:5432/oeml
# TLS mode. Supported: require | disable  (default: require). Use "disable" only for
# a local non-TLS dev database; production must use "require".
# DATABASE_SSL=require

# ---- Email notification (internal OEML trade-desk lead alert) ---------------
# Supported: none | resend | ses  (default: none)
#   none   = intentionally DISABLED (safe default): leads still persist, the log
#            heartbeat still records, no email is sent.
#   resend = the implemented transactional provider (needs RESEND_API_KEY below).
#   ses    = recognised but NOT implemented yet → selecting it FAILS LOUDLY (never a
#            silent disable).
# Selecting resend without RESEND_API_KEY / EMAIL_FROM / EMAIL_TO also fails loudly;
# it never destroys an accepted lead.
EMAIL_PROVIDER=none
# Verified sender + configured trade-desk recipient. Server config ONLY — a lead's own
# email never becomes from/to. Leave BLANK while EMAIL_PROVIDER=none; REQUIRED once a
# real provider is selected. Placeholders only in this tracked file (no real addresses).
# Dev/staging: EMAIL_FROM must be a Resend-verified/sandbox sender; EMAIL_TO a
# developer/manager test inbox. Production: OEML verified-domain sender + trade-desk inbox.
EMAIL_FROM=
EMAIL_TO=
# Reply-to behaviour. Supported: disabled | lead-email  (default: disabled).
# "lead-email" sets reply-to to the lead's ALREADY-VALIDATED email as a structured
# field (never a hand-built header). No CC/BCC.
EMAIL_REPLY_TO=disabled
# Resend API key — REQUIRED when EMAIL_PROVIDER=resend. Server-only secret; never
# committed, never logged, never returned from a route, no NEXT_PUBLIC. Set the real
# value in an untracked .env.local. For production the CLIENT should own the Resend
# account and issue this key (rotate any developer key at handover).
# RESEND_API_KEY=<set-in-untracked-.env.local>
# AWS SES keys are intentionally NOT defined (SES adapter not implemented).

# Shared secret guarding the internal notification-drain endpoint
# (POST /api/internal/notifications/drain), which a platform scheduler will call on an
# interval to recover/deliver pending notifications. Server-only; sent as
# "Authorization: Bearer <secret>"; never logged, never in a query string, no
# NEXT_PUBLIC. When UNSET the endpoint rejects every request (fail closed). Set a long
# random value in .env.local when a scheduler is attached.
# NOTIFICATION_DRAIN_SECRET=<set-in-untracked-.env.local>

# ---- Security (Sec Phase 4) -------------------------------------------------
# Bot-verification provider. Supported: disabled  (default: disabled)
# A no-op seam only; no CAPTCHA UX and no vendor code. A future approved provider
# plugs in behind lib/security/bot-verification.ts.
BOT_VERIFICATION=disabled

# Set to "1"/"true" ONLY when a trusted reverse proxy / host sets the client IP
# header (X-Forwarded-For) and strips any client-supplied value. Default false:
# the app-level enquiry rate limit is then defense-in-depth with a best-effort,
# spoofable identity. Authoritative, distributed rate limiting is an edge concern.
# RATE_LIMIT_TRUST_PROXY=1

# ---- Dev / QA helpers -------------------------------------------------------
# Force the market provider-failure path to exercise degraded UI. "1" | "true".
# (Ignored in production — see lib/config/env.ts.)
# MARKET_SIMULATE_FAILURE=1

# ---- Provider secrets (placeholders; set real values in .env.local only) ----
# Never commit real values. Read server-side only (lib/config/env.ts).

# MetalpriceAPI key — required for the live Gold benchmark.
# METALPRICE_API_KEY=<set-in-untracked-.env.local>

# Metals.Dev key — required for live LME Copper/Lead/Zinc benchmarks. Public
# display stays gated (publicDisplayApproved) until a paid plan + commercial
# rights are confirmed. See docs/market-provider-readiness.md.
# METALS_DEV_API_KEY=<set-in-untracked-.env.local>

# EIA key — required for the live Brent Crude benchmark (RBRTE). EIA data is
# public-domain U.S. Government data (attribution rendered in the UI). Free key
# from eia.gov/opendata.
# EIA_API_KEY=<set-in-untracked-.env.local>

# For FUTURE approved providers (do nothing until implemented & approved):
# ENQUIRY_CRM_API_KEY=<set-when-a-crm-or-email-provider-is-approved>
# UPLOAD_STORAGE_KEY=<set-when-a-storage-provider-is-approved>
# CONTENT_CMS_TOKEN=<set-when-a-cms-is-approved>
